# Copy to .env or Deployka env — NEVER commit real secrets
BOT_TOKEN=
SUPABASE_URL=
SUPABASE_KEY=                 # service_role — server-side only!
ADMIN_TELEGRAM_IDS=           # comma-separated TG ids (e.g. 65807806)

# AI (OpenAI-compatible; DeepSeek example)
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=sk-...
AI_CHAT_MODEL=deepseek-chat

# Embedding model name on the SAME base URL (set later via /embedmodel too).
# Dimension MUST match sql/01_init.sql (vector(1536)); change both together.
AI_EMBED_MODEL=
AI_EMBED_DIM=1536

# Optional overrides
MAX_FILE_MB=15
MAX_DOCS_PER_USER=5
MAX_UPLOADS_PER_DAY=3
MAX_QUESTIONS_PER_DAY=40
MAX_ANSWER_TOKENS=900
RAG_TOP_K=6
