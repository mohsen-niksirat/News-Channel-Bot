# Copy to .env or Deployka env — NEVER commit real secrets
#
# DEPLOYKA TIP: too many env vars → "Too many environment variables".
# Use the MINIMAL block below (4–5 vars). Everything else has code defaults.

# ===== REQUIRED =====
BOT_TOKEN=
SUPABASE_URL=
SUPABASE_KEY=
# Dahl key is the most reliable free-tier provider (DeepSeek 402 has no balance):
DAHL_API_KEY=

# ===== MINIMAL for Deployka (compact) =====
# All AI keys in ONE variable (provider=key separated by ; )
# Multiple keys per provider with | (round-robin + per-key cooldown):
AI_KEYS=dahl=sk-xxx

# ===== Optional overrides (leave unset to use code defaults) =====
BOT_ACTIVE=true           # set false to pause all scanning/publishing
ADMIN_TELEGRAM_IDS=       # comma-separated TG ids allowed to run /bot commands
AI_PROVIDER=dahl          # preferred provider: dahl | deepseek | xkiro | inception | vyce
AI_CHAIN=dahl,xkiro,inception,vyce,deepseek  # fallback order
DAHL_BASE_URL=https://inference.dahl.global/v1
DAHL_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
DEEPSEEK_API_KEY=         # recharge DeepSeek via https://api.deepseek.com — 402 by default
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SKIP_EN_WHEN_AI_FAILS=true     # skip English-only posts when AI translation fails
AI_FAIL_NOTIFY=true         # notify owner in private chat on AI failure
SCAN_INTERVAL_SEC=60        # how often to pull feeds
MAX_ITEMS_PER_SCAN=12       # max new articles created per scan per user
MAX_FEED_ITEMS=25           # max items parsed from each RSS feed
MAX_NEW_PER_SOURCE=2        # max new items accepted per source per scan
DEFAULT_AUTO_PUBLISH=false  # new users start in manual review mode
DIGEST_INTERVAL_HOURS=12    # periodic round-up post
DIGEST_MAX_ITEMS=15         # max items in the round-up
MAX_POST_IMAGES=3           # images per channel post
AI_MAX_TOKENS=700           # AI response max tokens
AI_TEMPERATURE=0.4          # AI creativity
DEFAULT_CHANNEL_FOOTER=     # optional footer text appended to every post
RETENTION_DAYS=1            # delete handled drafts+articles older than N days
CLEANUP_INTERVAL_SEC=3600   # how often cleanup runs

# ===== Separate keys (alternative to AI_KEYS) =====
# XKIRO_API_KEY=
# INCEPTION_API_KEY=
# VYCE_API_KEY=
# DAHL_API_KEY=
# DEEPSEEK_API_KEY=
